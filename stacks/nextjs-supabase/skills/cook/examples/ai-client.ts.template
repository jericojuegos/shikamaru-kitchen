import 'server-only';
import { generateText, generateObject, streamText } from 'ai';
import { createAnthropic } from '@ai-sdk/anthropic';
import { createGoogleGenerativeAI } from '@ai-sdk/google';
import { createOpenAI } from '@ai-sdk/openai';
import { AI_MODELS, AI_TEMPERATURE } from '@/lib/constants';

// ─── Provider Selection ───────────────────────────────────────────────────────
// Set AI_PROVIDER in .env.local to switch providers without code changes:
//   AI_PROVIDER=anthropic  → Claude (production recommended)
//   AI_PROVIDER=google     → Gemini (free tier — good for development)
//   AI_PROVIDER=openai     → GPT-4o (optional)
//
// Only the matching API key needs to be set.

type Provider = 'anthropic' | 'google' | 'openai';

function getProvider(): Provider {
  const provider = process.env.AI_PROVIDER as Provider | undefined;
  if (provider && ['anthropic', 'google', 'openai'].includes(provider)) {
    return provider;
  }
  // Auto-detect from which key is present
  if (process.env.ANTHROPIC_API_KEY) return 'anthropic';
  if (process.env.GOOGLE_AI_API_KEY) return 'google';
  if (process.env.OPENAI_API_KEY) return 'openai';
  throw new Error(
    'No AI provider configured. Set AI_PROVIDER and the matching API key in .env.local',
  );
}

function getModel() {
  const provider = getProvider();

  switch (provider) {
    case 'anthropic': {
      const client = createAnthropic({
        apiKey: process.env.ANTHROPIC_API_KEY,
      });
      return client(AI_MODELS.anthropic);
    }
    case 'google': {
      const client = createGoogleGenerativeAI({
        apiKey: process.env.GOOGLE_AI_API_KEY,
      });
      return client(AI_MODELS.google);
    }
    case 'openai': {
      const client = createOpenAI({
        apiKey: process.env.OPENAI_API_KEY,
      });
      return client(AI_MODELS.openai);
    }
  }
}

// ─── Exported AI helpers ──────────────────────────────────────────────────────
// Use these in Route Handlers — never import AI SDK directly in other files.
// All prompts live in src/lib/ai/prompts/ — never inline prompt strings here.

export async function aiGenerate(prompt: string, systemPrompt?: string) {
  const { text } = await generateText({
    model: getModel(),
    temperature: AI_TEMPERATURE,
    system: systemPrompt,
    prompt,
  });
  return text;
}

export async function aiGenerateObject<T>(
  prompt: string,
  schema: Parameters<typeof generateObject>[0]['schema'],
  systemPrompt?: string,
) {
  const { object } = await generateObject({
    model: getModel(),
    temperature: AI_TEMPERATURE,
    system: systemPrompt,
    prompt,
    schema,
  });
  return object as T;
}

export async function aiStream(prompt: string, systemPrompt?: string) {
  return streamText({
    model: getModel(),
    temperature: AI_TEMPERATURE,
    system: systemPrompt,
    prompt,
  });
}

// ─── Current provider (for logging / debugging) ───────────────────────────────
export function getCurrentProvider(): Provider {
  return getProvider();
}


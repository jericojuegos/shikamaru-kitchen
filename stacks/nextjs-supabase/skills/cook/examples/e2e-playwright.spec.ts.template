import { test, expect } from '@playwright/test';

/**
 * Golden-Path Playwright E2E Test Template (`e2e/<feature-slug>.spec.ts`)
 *
 * Rules for AI-Generated E2E Tests:
 * 1. ONLY write Playwright E2E tests for Critical User Journeys (Auth, Core Value Loop, Billing).
 * 2. ALWAYS use accessible user-facing locators (`getByRole`, `getByLabel`, `getByText`) or `getByTestId`.
 *    NEVER use brittle CSS class chains (`.div > .btn-primary:nth-child(2)`).
 * 3. Keep each Golden-Path spec focused on 1 happy-path flow + 1 validation/guard assertion.
 */
test.describe('Feature: <Feature Name> (<NN-feature-slug>)', () => {
  test('Req 1.1 & 1.2: completes the primary user journey end-to-end', async ({ page }) => {
    await page.goto('/<feature-route>');

    // 1. Verify initial screen renders accessible heading
    await expect(page.getByRole('heading', { level: 1 })).toBeVisible();

    // 2. Fill form inputs via accessible labels
    await page.getByLabel(/title|name|input/i).fill('Sample Valid Input');

    // 3. Submit via accessible button role
    await page.getByRole('button', { name: /submit|save|generate|continue/i }).click();

    // 4. Verify expected outcome (toast, redirect, or rendered result)
    await expect(page.getByRole('status').or(page.getByText(/success|saved|completed/i))).toBeVisible();
  });

  test('Req 1.3: shows accessible validation error and preserves input on invalid submission', async ({ page }) => {
    await page.goto('/<feature-route>');

    await page.getByRole('button', { name: /submit|save|generate|continue/i }).click();

    await expect(page.getByRole('alert')).toBeVisible();
  });
});

<?php
/**
 * Canonical Feature Module ServiceProvider + Thin REST Controller Template
 *
 * File 1: src/Modules/[Feature]/Providers/[Feature]ServiceProvider.php
 * File 2: src/Modules/[Feature]/Presentation/Rest/[Feature]RestController.php
 */

declare(strict_types=1);

namespace PluginNamespace\Modules\Reporting\Providers;

use PluginNamespace\Core\Container;
use PluginNamespace\Core\ServiceProvider;
use PluginNamespace\Modules\Reporting\Application\Handlers\GenerateReportHandler;
use PluginNamespace\Modules\Reporting\Domain\Contracts\EmployeeRepositoryInterface;
use PluginNamespace\Modules\Reporting\Infrastructure\Repositories\WordPressEmployeeRepository;
use PluginNamespace\Modules\Reporting\Presentation\Rest\ReportingRestController;

final class ReportingServiceProvider extends ServiceProvider {
    public function register( Container $container ): void {
        $container->singleton(
            EmployeeRepositoryInterface::class,
            static fn(): EmployeeRepositoryInterface => new WordPressEmployeeRepository()
        );

        $container->singleton(
            GenerateReportHandler::class,
            static fn( Container $c ): GenerateReportHandler => new GenerateReportHandler(
                $c->get( EmployeeRepositoryInterface::class )
            )
        );

        $container->singleton(
            ReportingRestController::class,
            static fn( Container $c ): ReportingRestController => new ReportingRestController(
                $c->get( GenerateReportHandler::class )
            )
        );
    }

    public function boot( Container $container ): void {
        \add_action( 'rest_api_init', [ $container->get( ReportingRestController::class ), 'registerRoutes' ] );
    }
}

// ============================================================================
// PRESENTATION REST ADAPTER (src/Modules/[Feature]/Presentation/Rest/ReportingRestController.php)
// Validates permissions & inputs, delegates to Application Handler, returns WP_REST_Response.
// ============================================================================
namespace PluginNamespace\Modules\Reporting\Presentation\Rest;

use PluginNamespace\Modules\Reporting\Application\Handlers\GenerateReportHandler;
use WP_Error;
use WP_REST_Request;
use WP_REST_Response;
use WP_REST_Server;

final class ReportingRestController {
    private const NAMESPACE = 'plugin-slug/v1';

    public function __construct(
        private readonly GenerateReportHandler $handler
    ) {}

    public function registerRoutes(): void {
        \register_rest_route(
            self::NAMESPACE,
            '/reports/(?P<employee_id>\d+)',
            [
                [
                    'methods'             => WP_REST_Server::READABLE,
                    'callback'            => [ $this, 'getReport' ],
                    'permission_callback' => [ $this, 'canViewReport' ],
                    'args'                => [
                        'employee_id' => [
                            'required'          => true,
                            'sanitize_callback' => 'absint',
                            'validate_callback' => static fn( $param ): bool => is_numeric( $param ) && (int) $param > 0,
                        ],
                    ],
                ],
            ]
        );
    }

    public function canViewReport( WP_REST_Request $request ): bool|WP_Error {
        if ( ! \current_user_can( 'manage_options' ) ) {
            return new WP_Error(
                'rest_forbidden',
                \__( 'You do not have permission to view this report.', 'plugin-slug' ),
                [ 'status' => 403 ]
            );
        }
        return true;
    }

    public function getReport( WP_REST_Request $request ): WP_REST_Response|WP_Error {
        $employeeId = \absint( $request->get_param( 'employee_id' ) );
        try {
            $report = $this->handler->execute( $employeeId );
            return new WP_REST_Response( $report->toArray(), 200 );
        } catch ( \Throwable $e ) {
            return new WP_Error( 'report_generation_failed', \esc_html( $e->getMessage() ), [ 'status' => 404 ] );
        }
    }
}

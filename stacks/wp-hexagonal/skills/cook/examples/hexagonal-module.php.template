<?php
/**
 * Canonical Hexagonal Domain Port + Application Handler + WP Repository Adapter Template
 *
 * File 1: src/Modules/[Feature]/Domain/Contracts/[Entity]RepositoryInterface.php
 * File 2: src/Modules/[Feature]/Application/Handlers/[UseCase]Handler.php
 * File 3: src/Modules/[Feature]/Infrastructure/Repositories/WordPress[Entity]Repository.php
 */

declare(strict_types=1);

// ============================================================================
// 1. DOMAIN PORT (src/Modules/[Feature]/Domain/Contracts/[Entity]RepositoryInterface.php)
// Zero WordPress imports allowed here.
// ============================================================================
namespace PluginNamespace\Modules\Reporting\Domain\Contracts;

use PluginNamespace\Modules\Reporting\Domain\Entities\Employee;

interface EmployeeRepositoryInterface {
    public function findById( int $employeeId ): ?Employee;
}

// ============================================================================
// 2. APPLICATION USE-CASE HANDLER (src/Modules/[Feature]/Application/Handlers/GenerateReportHandler.php)
// Depends ONLY on Domain Contracts / Ports. Testable without booting WordPress.
// ============================================================================
namespace PluginNamespace\Modules\Reporting\Application\Handlers;

use PluginNamespace\Modules\Reporting\Domain\Contracts\EmployeeRepositoryInterface;
use PluginNamespace\Modules\Reporting\Domain\Entities\Report;
use RuntimeException;

final class GenerateReportHandler {
    public function __construct(
        private readonly EmployeeRepositoryInterface $employees
    ) {}

    public function execute( int $employeeId ): Report {
        $employee = $this->employees->findById( $employeeId );
        if ( null === $employee ) {
            throw new RuntimeException( sprintf( 'Employee %d not found.', $employeeId ) );
        }

        return $employee->calculateAccreditationReport();
    }
}

// ============================================================================
// 3. WORDPRESS INFRASTRUCTURE ADAPTER (src/Modules/[Feature]/Infrastructure/Repositories/WordPressEmployeeRepository.php)
// Talks to $wpdb / WP_User / LearnDash and maps to pure Domain Entities.
// ============================================================================
namespace PluginNamespace\Modules\Reporting\Infrastructure\Repositories;

use PluginNamespace\Modules\Reporting\Domain\Contracts\EmployeeRepositoryInterface;
use PluginNamespace\Modules\Reporting\Domain\Entities\Employee;

final class WordPressEmployeeRepository implements EmployeeRepositoryInterface {
    public function findById( int $employeeId ): ?Employee {
        if ( ! function_exists( 'get_userdata' ) ) {
            return null;
        }

        $wpUser = \get_userdata( $employeeId );
        if ( ! $wpUser instanceof \WP_User ) {
            return null;
        }

        return new Employee(
            id: (int) $wpUser->ID,
            email: (string) $wpUser->user_email,
            displayName: (string) $wpUser->display_name
        );
    }
}

<?php
/**
 * ==============================================================================
 * Mechanical Architecture & Security Linter ("The Codebase Does the Reviewing")
 * Location: tests/Unit/ArchitectureTest.php
 *
 * Inspired by Lauren Tan's (`@poteto` / `pstack`) mechanical constraint philosophy:
 * Runs in < 50ms during `vendor/bin/phpunit` (WITHOUT booting WordPress) and
 * mechanically blocks the top WordPress agent failure modes:
 *
 *   1. Direct Access Guard: Every PHP file in `includes/` & `templates/` has `ABSPATH` check
 *   2. View Purity: `templates/` views contain zero raw `$wpdb->` SQL queries
 *   3. Module Isolation: `includes/modules/<module-a>/` does not hard-couple to `<module-b>`
 *   4. Anti-Slop Modularity Cap: PHP classes/views stay under 350 lines
 *   5. No Linter Escape Hatches or Unfinished Slop Placeholders (`phpcs:ignore`, `@phpstan-ignore`, `TODO:`, `FIXME:`)
 * ==============================================================================
 */

declare(strict_types=1);

namespace PluginNamespace\Tests\Unit;

use PHPUnit\Framework\TestCase;
use RecursiveDirectoryIterator;
use RecursiveIteratorIterator;
use SplFileInfo;

final class ArchitectureTest extends TestCase {

    private const MAX_FILE_LINES = 350;

    /**
     * @return list<string>
     */
    private function getPhpFiles( string $relativeDir ): array {
        $baseDir = dirname( __DIR__, 2 ) . '/' . ltrim( $relativeDir, '/' );
        if ( ! is_dir( $baseDir ) ) {
            return [];
        }

        $files    = [];
        $iterator = new RecursiveIteratorIterator( new RecursiveDirectoryIterator( $baseDir ) );
        /** @var SplFileInfo $file */
        foreach ( $iterator as $file ) {
            if ( $file->isFile() && $file->getExtension() === 'php' ) {
                $files[] = $file->getPathname();
            }
        }
        return $files;
    }

    public function test_every_php_file_in_includes_and_templates_enforces_abspath_guard(): void {
        $files      = array_merge( $this->getPhpFiles( 'includes' ), $this->getPhpFiles( 'templates' ) );
        $violations = [];

        foreach ( $files as $file ) {
            $content = (string) file_get_contents( $file );
            if ( ! str_contains( $content, 'ABSPATH' ) ) {
                $violations[] = basename( $file ) . ' is missing if ( ! defined( \'ABSPATH\' ) ) exit;';
            }
        }

        $this->assertSame( [], $violations, "Missing ABSPATH guard:\n" . implode( "\n", $violations ) );
    }

    public function test_presentation_templates_contain_zero_direct_wpdb_queries(): void {
        $templates  = $this->getPhpFiles( 'templates' );
        $violations = [];

        foreach ( $templates as $file ) {
            $content = (string) file_get_contents( $file );
            if ( str_contains( $content, '$wpdb' ) ) {
                $violations[] = basename( $file ) . ' accesses $wpdb directly inside a presentation template';
            }
        }

        $this->assertSame( [], $violations, "Template layer violations:\n" . implode( "\n", $violations ) );
    }

    public function test_php_files_respect_anti_slop_line_count_cap(): void {
        $files      = array_merge( $this->getPhpFiles( 'includes' ), $this->getPhpFiles( 'templates' ) );
        $violations = [];

        foreach ( $files as $file ) {
            $lines = substr_count( (string) file_get_contents( $file ), "\n" ) + 1;
            if ( $lines > self::MAX_FILE_LINES ) {
                $violations[] = basename( $file ) . " is {$lines} lines (cap: " . self::MAX_FILE_LINES . ')';
            }
        }

        $this->assertSame( [], $violations, "Modularity cap violations:\n" . implode( "\n", $violations ) );
    }

    public function test_php_files_contain_zero_escape_hatches_or_unfinished_todo_placeholders(): void {
        $files      = array_merge( $this->getPhpFiles( 'includes' ), $this->getPhpFiles( 'templates' ) );
        $violations = [];

        foreach ( $files as $file ) {
            $content = (string) file_get_contents( $file );
            if ( preg_match( '/phpcs:(?:ignore|disable)|@phpstan-ignore/', $content ) ) {
                $violations[] = basename( $file ) . ' contains linter escape hatch (phpcs:ignore / @phpstan-ignore)';
            }
            if ( preg_match( '/\/\/\s*(?:TODO|FIXME|HACK)\b|\/\*\s*(?:TODO|FIXME|HACK)\b/i', $content ) ) {
                $violations[] = basename( $file ) . ' contains unfinished TODO/FIXME/HACK placeholder comment';
            }
        }

        $this->assertSame( [], $violations, "Escape-hatch or placeholder violations:\n" . implode( "\n", $violations ) );
    }
}

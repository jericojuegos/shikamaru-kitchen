import { test, expect } from '@playwright/test';

/**
 * WordPress Golden-Path Playwright E2E Test Template (`e2e/<feature-slug>.spec.ts`)
 *
 * Rules:
 * 1. Use for critical WP Admin settings saves, shortcode/block front-end flows, or AJAX submissions.
 * 2. Always prefer `getByRole`, `getByLabel`, or `data-testid` over fragile DOM hierarchy selectors.
 */
test.describe('WP Feature: <Feature Name> (<NN-feature-slug>)', () => {
  test('Req 1.1: renders front-end block/shortcode and handles user interaction', async ({ page }) => {
    await page.goto('/<sample-page-slug>/');

    await expect(page.getByRole('heading', { name: /<Feature Heading>/i })).toBeVisible();
    await page.getByRole('button', { name: /submit|apply|save/i }).click();

    await expect(page.getByRole('status')).toBeVisible();
  });
});
